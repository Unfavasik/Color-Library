{
  "name": "Color Library",
  "short_name": "Color Library",
  "description": "A modern color library for exploring, copying, and using HTML and CSS color codes.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/og-image.webp",
      "sizes": "1200x630",
      "type": "image/webp"
    }
  ]
}
